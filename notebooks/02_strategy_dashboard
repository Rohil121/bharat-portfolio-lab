        "\n",
        "marker = \"\"\"# ---------------------------------------------------------\n",
        "# Preliminary layout\n",
        "# ---------------------------------------------------------\"\"\"\n",
        "\n",
        "backtest_block = \"\"\"# ---------------------------------------------------------\n",
        "# Lagged execution schedule\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "execution_records = []\n",
        "execution_schedule_records = []\n",
        "\n",
        "for signal_date, target_row in strategy_target_weights.iterrows():\n",
