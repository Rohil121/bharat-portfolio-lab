        "        current_asset_values\n",
        "        / current_portfolio_value\n",
        "    )\n",
        "\n",
        "\n",
        "adaptive_strategy_value = (\n",
        "    pd.Series(\n",
        "        strategy_value_records,\n",
        "        name=\"Adaptive Barbell Strategy\",\n",
