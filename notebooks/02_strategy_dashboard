      "source": [
        "## 4. Strategy Signal Generation\n",
        "\n",
        "The Adaptive Barbell strategy uses only information available on or before each rebalance date.\n",
        "\n",
        "The preliminary signals are:\n",
        "\n",
        "- six-month price momentum,\n",
        "- three-month annualised volatility, and\n",
        "- the Nifty 50's position relative to its 200-day moving average.\n",
        "\n",
        "Monthly rebalance dates are defined as the final available trading session of each calendar month."
      ],
      "metadata": {
        "id": "JaE_PrFVXaDz"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate daily stock returns\n",
        "\n",
        "stock_daily_returns = (\n",
        "    stock_prices\n",
        "    .pct_change()\n",
        ")\n",
        "\n",
        "# Six-month price momentum\n",
        "momentum_6m = (\n",
        "    stock_prices\n",
        "    .div(stock_prices.shift(MOMENTUM_LOOKBACK))\n",
        "    .sub(1)\n",
        ")\n",
        "\n",
        "# Three-month annualised volatility\n",
        "annualised_volatility_3m = (\n",
        "    stock_daily_returns\n",
        "    .rolling(\n",
        "        window=VOLATILITY_LOOKBACK,\n",
        "        min_periods=VOLATILITY_LOOKBACK,\n",
        "    )\n",
        "    .std(ddof=1)\n",
        "    .mul(np.sqrt(TRADING_DAYS))\n",
        ")\n",
        "\n",
        "# Nifty 50 market-trend signal\n",
        "benchmark_series = (\n",
        "    benchmark_prices[BENCHMARK_NAME]\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "benchmark_ma_200 = (\n",
        "    benchmark_series\n",
        "    .rolling(\n",
        "        window=TREND_LOOKBACK,\n",
        "        min_periods=TREND_LOOKBACK,\n",
        "    )\n",
        "    .mean()\n",
        ")\n",
        "\n",
        "# Final available trading date in each calendar month\n",
        "month_end_dates = (\n",
        "    stock_prices\n",
        "    .groupby(stock_prices.index.to_period(\"M\"))\n",
        "    .tail(1)\n",
        "    .index\n",
        ")\n",
        "\n",
        "# Keep only dates where every required signal exists\n",
        "valid_rebalance_dates = []\n",
        "\n",
        "for rebalance_date in month_end_dates:\n",
        "\n",
        "    momentum_available = (\n",
        "        momentum_6m\n",
        "        .loc[rebalance_date, growth_tickers]\n",
        "        .notna()\n",
        "        .all()\n",
        "    )\n",
        "\n",
        "    volatility_available = (\n",
        "        annualised_volatility_3m\n",
        "        .loc[rebalance_date, portfolio_tickers]\n",
        "        .notna()\n",
        "        .all()\n",
        "    )\n",
        "\n",
        "    trend_available = pd.notna(\n",
        "        benchmark_ma_200.loc[rebalance_date]\n",
        "    )\n",
        "\n",
        "    if (\n",
        "        momentum_available\n",
        "        and volatility_available\n",
        "        and trend_available\n",
        "    ):\n",
        "        valid_rebalance_dates.append(rebalance_date)\n",
        "\n",
        "valid_rebalance_dates = pd.DatetimeIndex(\n",
        "    valid_rebalance_dates\n",
        ")\n",
        "\n",
        "# Validation checks\n",
        "assert not momentum_6m.empty\n",
        "assert not annualised_volatility_3m.empty\n",
        "assert len(valid_rebalance_dates) > 0, \\\n",
        "    \"No valid rebalance dates were generated.\"\n",
        "\n",
        "print(\"Strategy signals calculated successfully.\")\n",
        "print(\"-\" * 55)\n",
        "print(\n",
        "    f\"First valid rebalance date: \"\n",
        "    f\"{valid_rebalance_dates.min().date()}\"\n",
        ")\n",
        "print(\n",
        "    f\"Latest valid rebalance date: \"\n",
        "    f\"{valid_rebalance_dates.max().date()}\"\n",
        ")\n",
        "print(\n",
        "    f\"Number of valid monthly rebalances: \"\n",
        "    f\"{len(valid_rebalance_dates)}\"\n",
        ")"
      ],
