    {
      "cell_type": "code",
      "source": [
        "# Locate the trading day immediately before the first execution date\n",
        "\n",
        "first_execution_date = execution_targets.index.min()\n",
        "\n",
        "first_execution_position = stock_prices.index.get_loc(\n",
        "    first_execution_date\n",
        ")\n",
        "\n",
        "if first_execution_position == 0:\n",
        "    raise ValueError(\n",
        "        \"A previous trading date is required to initialise the backtest.\"\n",
        "    )\n",
        "\n",
        "backtest_initial_date = stock_prices.index[\n",
        "    first_execution_position - 1\n",
        "]\n",
        "\n",
        "simulation_dates = stock_prices.loc[\n",
        "    first_execution_date:\n",
        "].index\n",
        "\n",
        "\n",
        "# Begin with the full portfolio value held in cash\n",
        "\n",
        "asset_names = portfolio_tickers + [\"Cash\"]\n",
        "\n",
        "current_asset_values = pd.Series(\n",
        "    0.0,\n",
        "    index=asset_names,\n",
        "    dtype=float,\n",
        ")\n",
        "\n",
        "current_asset_values[\"Cash\"] = INITIAL_CAPITAL\n",
        "\n",
        "\n",
        "# Output records\n",
        "\n",
        "strategy_value_records = {\n",
        "    backtest_initial_date: INITIAL_CAPITAL\n",
        "}\n",
        "\n",
        "weight_history_records = {\n",
        "    backtest_initial_date: (\n",
        "        current_asset_values / INITIAL_CAPITAL\n",
        "    )\n",
        "}\n",
        "\n",
        "turnover_records = {}\n",
        "transaction_cost_records = {}\n",
        "rebalance_value_records = {}\n",
        "\n",
        "\n",
        "# Run the daily simulation\n",
        "\n",
        "for current_date in simulation_dates:\n",
        "\n",
        "    portfolio_value_before_rebalance = (\n",
        "        current_asset_values.sum()\n",
        "    )\n",
        "\n",
        "    # ---------------------------------------------------------\n",
        "    # Rebalance at the beginning of an execution date\n",
        "    # ---------------------------------------------------------\n",
        "\n",
        "    if current_date in execution_targets.index:\n",
        "\n",
        "        target_weights = (\n",
        "            execution_targets\n",
        "            .loc[current_date]\n",
        "            .reindex(asset_names)\n",
        "            .astype(float)\n",
        "        )\n",
        "\n",
        "        current_weights_before_trade = (\n",
        "            current_asset_values\n",
        "            / portfolio_value_before_rebalance\n",
        "        )\n",
        "\n",
        "        # One-way portfolio turnover\n",
        "        one_way_turnover = (\n",
        "            0.5\n",
        "            * (\n",
        "                target_weights\n",
        "                - current_weights_before_trade\n",
        "            )\n",
        "            .abs()\n",
        "            .sum()\n",
        "        )\n",
        "\n",
        "        transaction_cost = (\n",
        "            portfolio_value_before_rebalance\n",
        "            * one_way_turnover\n",
        "            * TRANSACTION_COST_RATE\n",
        "        )\n",
        "\n",
        "        portfolio_value_after_cost = (\n",
        "            portfolio_value_before_rebalance\n",
        "            - transaction_cost\n",
        "        )\n",
        "\n",
        "        # Allocate remaining portfolio value to target weights\n",
        "        current_asset_values = (\n",
        "            target_weights\n",
        "            * portfolio_value_after_cost\n",
        "        )\n",
        "\n",
        "        turnover_records[current_date] = one_way_turnover\n",
        "        transaction_cost_records[current_date] = transaction_cost\n",
        "        rebalance_value_records[current_date] = (\n",
        "            portfolio_value_before_rebalance\n",
        "        )\n",
        "\n",
        "    # ---------------------------------------------------------\n",
        "    # Apply daily market returns\n",
        "    # ---------------------------------------------------------\n",
        "\n",
        "    daily_equity_returns = (\n",
        "        backtest_stock_returns\n",
        "        .loc[current_date, portfolio_tickers]\n",
        "        .fillna(0.0)\n",
        "    )\n",
        "\n",
        "    current_asset_values.loc[portfolio_tickers] *= (\n",
        "        1 + daily_equity_returns\n",
        "    )\n",
        "\n",
        "    current_asset_values[\"Cash\"] *= (\n",
        "        1 + daily_cash_return\n",
        "    )\n",
        "\n",
        "    current_portfolio_value = (\n",
        "        current_asset_values.sum()\n",
        "    )\n",
        "\n",
        "    strategy_value_records[current_date] = (\n",
        "        current_portfolio_value\n",
        "    )\n",
        "\n",
        "    weight_history_records[current_date] = (\n",
        "        current_asset_values\n",
        "        / current_portfolio_value\n",
        "    )\n",
        "\n",
        "\n",
        "# Convert records into pandas objects\n",
        "\n",
        "adaptive_strategy_value = (\n",
        "    pd.Series(\n",
        "        strategy_value_records,\n",
        "        name=\"Adaptive Barbell Strategy\",\n",
        "    )\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "strategy_weight_history = (\n",
        "    pd.DataFrame(weight_history_records)\n",
        "    .T\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "strategy_turnover = (\n",
        "    pd.Series(\n",
        "        turnover_records,\n",
        "        name=\"One-Way Turnover\",\n",
        "    )\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "strategy_transaction_costs = (\n",
        "    pd.Series(\n",
        "        transaction_cost_records,\n",
        "        name=\"Transaction Cost\",\n",
        "    )\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "strategy_rebalance_values = (\n",
        "    pd.Series(\n",
        "        rebalance_value_records,\n",
        "        name=\"Portfolio Value Before Rebalance\",\n",
        "    )\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "\n",
        "# Validation checks\n",
        "\n",
        "assert adaptive_strategy_value.notna().all(), \\\n",
        "    \"Missing strategy values detected.\"\n",
        "\n",
        "assert (adaptive_strategy_value > 0).all(), \\\n",
        "    \"Non-positive portfolio value detected.\"\n",
        "\n",
        "assert np.allclose(\n",
        "    strategy_weight_history.sum(axis=1),\n",
        "    1.0,\n",
        "), \"Recorded portfolio weights do not total 100%.\"\n",
        "\n",
        "assert (\n",
        "    strategy_weight_history >= -1e-10\n",
        ").all().all(), \"Negative portfolio weight detected.\"\n",
        "\n",
        "assert len(strategy_turnover) == len(\n",
        "    strategy_transaction_costs\n",
        "), \"Turnover and transaction-cost records are inconsistent.\"\n",
        "\n",
        "\n",
        "print(\"Adaptive strategy backtest completed successfully.\")\n",
        "print(\"-\" * 60)\n",
        "print(f\"Backtest initial date: {backtest_initial_date.date()}\")\n",
        "print(f\"First trade date: {first_execution_date.date()}\")\n",
        "print(\n",
        "    f\"Latest portfolio value: \"\n",
