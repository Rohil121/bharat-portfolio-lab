        "## 6. Trade Execution Schedule\n",
        "\n",
        "Month-end signals are implemented on the following available trading session.\n",
        "\n",
        "This one-trading-day lag prevents the backtest from using information before it would realistically have been available and reduces look-ahead bias."
      ],
      "metadata": {
        "id": "iC8Va7OKX4jW"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Convert month-end signal dates into next-trading-day execution dates\n",
        "\n",
        "execution_records = []\n",
        "execution_mapping_records = []\n",
        "\n",
        "for signal_date, target_weights in strategy_target_weights.iterrows():\n",
        "\n",
        "    # Find the position immediately after the signal date\n",
        "    next_position = stock_prices.index.searchsorted(\n",
        "        signal_date,\n",
        "        side=\"right\",\n",
        "    )\n",
        "\n",
        "    # Skip the final signal if no later trading date exists\n",
        "    if next_position >= len(stock_prices.index):\n",
        "        continue\n",
        "\n",
        "    execution_date = stock_prices.index[next_position]\n",
        "\n",
        "    execution_row = target_weights.copy()\n",
        "    execution_row.name = execution_date\n",
        "\n",
        "    execution_records.append(execution_row)\n",
        "\n",
        "    execution_mapping_records.append(\n",
        "        {\n",
        "            \"Signal Date\": signal_date,\n",
        "            \"Execution Date\": execution_date,\n",
        "            \"Lag in Calendar Days\": (\n",
        "                execution_date - signal_date\n",
        "            ).days,\n",
        "            \"Market Regime\": strategy_regimes.loc[\n",
        "                signal_date,\n",
        "                \"Market Regime\",\n",
        "            ],\n",
        "            \"Equity Exposure\": strategy_regimes.loc[\n",
        "                signal_date,\n",
        "                \"Equity Exposure\",\n",
        "            ],\n",
        "            \"Cash Weight\": target_weights[\"Cash\"],\n",
        "        }\n",
        "    )\n",
        "\n",
        "execution_targets = (\n",
        "    pd.DataFrame(execution_records)\n",
        "    .groupby(level=0)\n",
        "    .last()\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "execution_schedule = (\n",
        "    pd.DataFrame(execution_mapping_records)\n",
        "    .set_index(\"Execution Date\")\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "# Align the schedule if duplicate execution dates were consolidated\n",
        "execution_schedule = execution_schedule.loc[\n",
        "    ~execution_schedule.index.duplicated(keep=\"last\")\n",
        "]\n",
        "\n",
        "# Validation checks\n",
        "assert not execution_targets.empty, \\\n",
        "    \"No executable target weights were generated.\"\n",
        "\n",
        "assert execution_targets.index.is_monotonic_increasing, \\\n",
        "    \"Execution dates are not in chronological order.\"\n",
        "\n",
        "assert np.allclose(\n",
        "    execution_targets.sum(axis=1),\n",
        "    1.0,\n",
        "), \"Execution weights must total 100%.\"\n",
        "\n",
        "assert (\n",
        "    execution_schedule[\"Signal Date\"]\n",
        "    < execution_schedule.index\n",
        ").all(), \"An allocation was implemented before or on its signal date.\"\n",
        "\n",
        "assert (\n",
        "    execution_targets >= -1e-12\n",
        ").all().all(), \"Negative execution weight detected.\"\n",
        "\n",
        "print(\"Execution schedule created successfully.\")\n",
        "print(\"-\" * 55)\n",
        "print(\n",
        "    f\"First signal date: \"\n",
        "    f\"{execution_schedule['Signal Date'].min().date()}\"\n",
        ")\n",
        "print(\n",
        "    f\"First execution date: \"\n",
        "    f\"{execution_targets.index.min().date()}\"\n",
        ")\n",
        "print(\n",
        "    f\"Latest execution date: \"\n",
        "    f\"{execution_targets.index.max().date()}\"\n",
        ")\n",
        "print(\n",
        "    f\"Number of executable rebalances: \"\n",
        "    f\"{len(execution_targets)}\"\n",
        ")\n",
        "\n",
        "display(execution_schedule.tail(12))"
      ],
