        "## 3. Historical Market Data\n",
        "\n",
        "This section downloads adjusted daily prices for the flagship portfolio and Nifty 50 benchmark.\n",
        "\n",
        "The data will be used to generate momentum, volatility and market-regime signals for the Adaptive Barbell strategy."
      ],
      "metadata": {
        "id": "gQD3txQxXN8X"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Download adjusted historical prices\n",
        "\n",
        "all_tickers = portfolio_tickers + [BENCHMARK_TICKER]\n",
        "\n",
        "raw_market_data = yf.download(\n",
        "    tickers=all_tickers,\n",
        "    start=START_DATE,\n",
        "    end=DOWNLOAD_END_DATE.strftime(\"%Y-%m-%d\"),\n",
        "    auto_adjust=True,\n",
        "    progress=False,\n",
        "    threads=True,\n",
        ")\n",
        "\n",
        "# Extract closing-price data\n",
        "if isinstance(raw_market_data.columns, pd.MultiIndex):\n",
        "    close_prices = raw_market_data[\"Close\"].copy()\n",
        "else:\n",
        "    close_prices = raw_market_data[[\"Close\"]].copy()\n",
        "    close_prices.columns = all_tickers\n",
        "\n",
        "# Arrange columns consistently\n",
        "close_prices = (\n",
        "    close_prices\n",
        "    .reindex(columns=all_tickers)\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "# Record missing observations before cleaning\n",
        "missing_data = close_prices.isna().sum()\n",
        "\n",
        "# Fill only short gaps and remove incomplete rows\n",
        "close_prices = close_prices.ffill(limit=3).dropna()\n",
        "\n",
        "# Separate portfolio and benchmark prices\n",
        "stock_prices = close_prices[portfolio_tickers].copy()\n",
        "\n",
        "benchmark_prices = (\n",
        "    close_prices[[BENCHMARK_TICKER]]\n",
        "    .rename(columns={BENCHMARK_TICKER: BENCHMARK_NAME})\n",
        ")\n",
        "\n",
        "# Validation checks\n",
        "assert not stock_prices.empty, \"No stock-price data was downloaded.\"\n",
        "assert stock_prices.shape[1] == 10, \\\n",
        "    \"Historical data is not available for all 10 stocks.\"\n",
        "assert stock_prices.isna().sum().sum() == 0, \\\n",
        "    \"Missing values remain in stock-price data.\"\n",
        "assert benchmark_prices.isna().sum().sum() == 0, \\\n",
        "    \"Missing values remain in benchmark data.\"\n",
        "assert stock_prices.index.equals(benchmark_prices.index), \\\n",
        "    \"Stock and benchmark dates are not aligned.\"\n",
        "\n",
        "print(\"Historical market data downloaded successfully.\")\n",
        "print(\"-\" * 55)\n",
        "print(f\"First observation: {close_prices.index.min().date()}\")\n",
        "print(f\"Latest observation: {close_prices.index.max().date()}\")\n",
        "print(f\"Trading observations: {len(close_prices):,}\")\n",
        "print(f\"Portfolio securities: {stock_prices.shape[1]}\")\n",
        "\n",
        "print(\"\\nMissing observations before cleaning:\")\n",
        "display(missing_data.to_frame(\"Missing Days\"))\n",
        "\n",
        "print(\"\\nLatest adjusted closing prices:\")\n",
        "display(close_prices.tail())"
      ],
